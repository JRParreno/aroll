DATABASE_URL=postgresql://aroll:aroll@localhost:5432/aroll
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- CORS (production) ---
# Comma-separated list of allowed browser origins, e.g. your deployed admin/owner web URLs.
# Example: https://admin.example.com,https://owner.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- CORS (development only) ---
# When true, the API also accepts any http(s) origin on localhost or 127.0.0.1 (any port).
# This is convenient for local Vite/Flutter web dev but must be disabled in production:
#   CORS_ALLOW_LOCALHOST_REGEX=false
CORS_ALLOW_LOCALHOST_REGEX=true

# Local directory for registration document uploads (not committed to git).
REGISTRATION_UPLOAD_DIR=uploads/registrations
CONSENT_UPLOAD_DIR=uploads/consents

# --- Approval email (Business Code delivery) ---
# Required before an administrator can send the post-approval login email.
# Copy these keys into backend/.env and fill them from your SMTP provider.
# Leave SMTP_HOST empty to disable delivery. Never commit real credentials.
# Gmail STARTTLS: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_USE_TLS=true SMTP_USE_SSL=false
# Use the Gmail address for SMTP_USERNAME and SMTP_FROM_EMAIL.
# Put a Google App Password in backend/.env as SMTP_PASSWORD (never commit it).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# Existing Business Owner login page used in the approval email.
OWNER_LOGIN_URL=http://localhost:5173/owner-login

# --- Optional OS push (Firebase Cloud Messaging) ---
# Inbox notifications work without these. Set both to enable FCM delivery.
# FCM_SERVICE_ACCOUNT_JSON may be a file path or the raw JSON document.
# google-auth must be installed on the API host for token refresh.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
SCHEDULE_REMINDER_LOOP_ENABLED=true
SCHEDULE_REMINDER_INTERVAL_SECONDS=900
